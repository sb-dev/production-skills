{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production Skills Family Conformance Record",
  "type": "object",
  "required": [
    "project",
    "checked_at",
    "summary",
    "checks"
  ],
  "properties": {
    "project": {
      "type": "string"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "required": ["pass", "warn", "fail", "not_applicable"],
      "properties": {
        "pass": { "type": "integer", "minimum": 0 },
        "warn": { "type": "integer", "minimum": 0 },
        "fail": { "type": "integer", "minimum": 0 },
        "not_applicable": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "message", "evidence"],
        "properties": {
          "status": {
            "enum": ["pass", "warn", "fail", "not-applicable"]
          },
          "message": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
